{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@enums": ["Bitburner-API/Enums"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react",
    "module": "commonjs",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ESNext"
  }
}
